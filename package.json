{
  "name": "gem-merchant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,ws -c cyan,magenta \"next dev --port 3100\" \"tsx watch --include .env.local --include .env server/index.ts\"",
    "dev:web": "next dev --port 3100",
    "dev:ws": "tsx watch --include .env.local --include .env server/index.ts",
    "build": "next build",
    "start": "next start",
    "start:ws": "tsx server/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "framer-motion": "^13.4.4",
    "mongodb": "^7.6.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
